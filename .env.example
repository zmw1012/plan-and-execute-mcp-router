# Copy to a local git-ignored file and fill in. Never commit real secrets.
# Mock demo does not require real keys.

# --- Generation (Alibaba profile for next experiments) ---
# ENV_FILE=.env.aliyun
LLM_PROVIDER=aliyun
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=your_llm_api_key_here
# Do not use LLM_MODEL=auto.

# --- Embeddings (separate profile; Operation-Visible retrieval) ---
# EMBEDDING_ENV_FILE=.env.embedding-relay
# Adapted backbone vs paper cohere.embed-v4.0:
EMBEDDING_BASE_URL=https://your-relay.example/v1
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
# Do not fall back to lexical-only or the generation endpoint.

# Optional domain keys (unused by mock financial store)
FINANCIAL_DATA_API_KEY=your_financial_data_api_key_here
NEWS_DATA_API_KEY=your_news_data_api_key_here
