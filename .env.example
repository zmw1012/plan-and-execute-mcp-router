# Copy to a local git-ignored file (e.g. .env.generation / .env.embedding).
# Fill placeholders only. NEVER commit real secrets, tokens, or private relay hosts.

# =============================================================================
# Generation provider (pass as --env-file / GEN_ENV)
# =============================================================================
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-generation-endpoint.example/v1
LLM_MODEL=your_generation_model_id
LLM_API_KEY=your_llm_api_key_here
# Do not use LLM_MODEL=auto.

# =============================================================================
# Embedding provider (pass as --embedding-env-file / EMBEDDING_ENV)
# Keep separate from generation credentials.
# =============================================================================
EMBEDDING_BASE_URL=https://your-embedding-endpoint.example/v1
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=your_embedding_model_id
# Do not fall back to lexical-only or the generation endpoint for formal runs.

# =============================================================================
# Real MCP / market data providers (HK-155 live only)
# =============================================================================
# FINANCIAL_DATA_API_KEY=your_financial_data_api_key_here
# NEWS_DATA_API_KEY=your_news_data_api_key_here
# Additional provider keys as required by your local MCP server configs.
# Prefer mocking for offline work; live runs may download HKEX / Sina / Eastmoney data.

# =============================================================================
# Optional ETOM settings
# =============================================================================
# MCP_ROUTER_ETOM_DATA_ROOT=/absolute/or/relative/path/to/etom/raw
# ETOM_SOURCE_DIR=/absolute/or/relative/path/to/etom/raw
# PE_FIN_REPLAN_ETOM_ALLOW_LIVE=0
# Set to 1 only with --allow-live-formal100 for paid ETOM PlanRoute runs.

# =============================================================================
# Frozen artifact roots (offline audits / gated tests)
# =============================================================================
# MCP_ROUTER_HK_ARTIFACT_ROOT=/path/to/frozen/hk155/outputs
# MCP_ROUTER_ETOM_ARTIFACT_ROOT=/path/to/frozen/etom100/outputs
